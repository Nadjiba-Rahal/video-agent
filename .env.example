# ============================================================
# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub (it is already
# listed in .gitignore below).
# ============================================================

# --- LLM (brain of the agent) -------------------------------
# Which model litellm should call. Examples:
#   "gpt-4o-mini"                (needs OPENAI_API_KEY)
#   "huggingface/Qwen/Qwen2.5-72B-Instruct"  (needs HF_TOKEN)
#   "ollama/llama3"               (needs nothing, runs locally)
MODEL_ID=gpt-4o-mini

# The API key for whichever provider you picked above.
# This is the ONLY variable name the code reads for the LLM key.
MODEL_API_KEY=your-openai-or-hf-key-here

# --- Video generation service --------------------------------
# Base URL of the video generation API ("agnes" in the original
# project). Replace with the real endpoint you are using.
AGNES_API_URL=https://api.your-video-provider.com
AGNES_API_KEY=your-video-provider-key-here

# --- App settings ----------------------------------------------
# How often (seconds) to poll the video job while it renders.
POLL_INTERVAL_SECONDS=3
# Give up after this many seconds if the video never finishes.
POLL_TIMEOUT_SECONDS=300

# Gradio server settings
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
